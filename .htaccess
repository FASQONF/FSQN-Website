# Security headers
<IfModule mod_headers.c>
  # HSTS
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  # Referrer
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # MIME sniffing
  Header always set X-Content-Type-Options "nosniff"

  # Clickjacking
  Header always set X-Frame-Options "SAMEORIGIN"

  # CORP
  Header always set Cross-Origin-Resource-Policy "same-origin"

  # CSP
  Header always set Content-Security-Policy "\
    default-src 'none'; \
    base-uri 'none'; \
    object-src 'none'; \
    frame-ancestors 'self'; \
    form-action 'self'; \
    script-src 'self'; \
    style-src 'self'; \
    img-src 'self' data:; \
    font-src 'self' data:; \
    connect-src 'self'; \
    media-src 'self'; \
    upgrade-insecure-requests"
</IfModule>

# Enable URL rewriting and redirection engine
RewriteEngine On

# Force redirect to HTTPS
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Single-Page-App routing: everything that is not a file or directory goes to index.html
# Avoid 404 and other possible pages while there are only a couple of pages on the site
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

# Default charset and disable directory listing
AddDefaultCharset UTF-8
Options -Indexes

# Caching of static resources
<IfModule mod_expires.c>
  ExpiresActive On

  # Do not cache HTML
  ExpiresByType text/html                        "access plus 0 seconds"
  
  # CSS and JS — 1 month
  ExpiresByType text/css                         "access plus 1 month"
  ExpiresByType application/javascript           "access plus 1 month"
  ExpiresByType text/javascript                  "access plus 1 month"

  # Fonts — 1 year
  ExpiresByType application/font-woff            "access plus 1 year"
  ExpiresByType application/font-woff2           "access plus 1 year"
  ExpiresByType application/vnd.ms-fontobject    "access plus 1 year"
  ExpiresByType font/ttf                         "access plus 1 year"
  ExpiresByType font/eot                         "access plus 1 year"

  # Images — 1 year
  ExpiresByType image/jpeg                       "access plus 1 year"
  ExpiresByType image/png                        "access plus 1 year"
  ExpiresByType image/gif                        "access plus 1 year"
  ExpiresByType image/svg+xml                    "access plus 1 year"

  # Video — 1 year
  ExpiresByType video/mp4                        "access plus 1 year"
</IfModule>

# Caching
<IfModule mod_headers.c>
  # Set Cache-Control header for static files
  <FilesMatch "\.(css|js|woff2?|ttf|eot|svg|jpe?g|png|gif|mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
